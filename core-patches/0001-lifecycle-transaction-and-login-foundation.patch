+    time_t expire_time, bool has_items)
+{
+    // Add to DB
+    std::string safe_subject = GetSubject();
+    CharacterDatabase.escape_string(safe_subject);
+
+    std::string safe_body = GetBody();
+    CharacterDatabase.escape_string(safe_body);
