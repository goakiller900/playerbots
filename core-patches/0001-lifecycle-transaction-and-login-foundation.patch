+namespace
+{
+    class AcknowledgedTransaction final : public SqlOperation
+    {
+    public:
+        explicit AcknowledgedTransaction(std::function<bool(SqlConnection&)> body)
+            : m_body(std::move(body)) {}
+
+        std::future<bool> GetFuture() { return m_result.get_future(); }
+
+        bool Execute(SqlConnection* connection) override
+        {
+            SqlConnection::Lock lock(connection);
+            const bool committed = RunAcknowledgedTransaction(*connection, m_body);
+            m_result.set_value(committed);
+            return committed;
+        }
+
+    private:
+        std::function<bool(SqlConnection&)> m_body;
+        std::promise<bool> m_result;
+    };
+}
+
+std::future<bool> Database::QueueTransaction(std::function<bool(SqlConnection&)> body)
+{
+    auto operation = std::make_unique<AcknowledgedTransaction>(std::move(body));
+    auto result = operation->GetFuture();
+    MANGOS_ASSERT(!m_currentTransaction.get());
+    if (m_pAsyncConn && m_threadBody)
+        m_threadBody->Delay(operation.release());
+    // An unavailable worker produces a broken promise; callers must fail closed.
+    return result;
+}
+
+std::future<bool> Database::CommitTransactionAcknowledged(
+    std::function<bool(SqlConnection&)> before,
+    std::function<bool(SqlConnection&)> after)
+{
+    if (!m_currentTransaction.get() || !before || !after)
+    {
+        m_currentTransaction.reset();
+        std::promise<bool> rejected;
+        auto result = rejected.get_future();
+        rejected.set_value(false);
+        return result;
+    }
+    // shared_ptr keeps the captured queue copyable for std::function while the
+    // operation owns its lifetime through completion or worker shutdown.
+    std::shared_ptr<SqlTransaction> statements(m_currentTransaction.release());
+    return QueueTransaction([statements, before = std::move(before), after = std::move(after)](SqlConnection& connection)
+    {
+        return before(connection) && statements->ExecuteStatements(&connection) && after(connection);
+    });
+}
+
 #define MIN_CONNECTION_POOL_SIZE 1
 #define MAX_CONNECTION_POOL_SIZE 16
 
