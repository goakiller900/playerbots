+// Queue only: the owning retirement transaction must include its durable receipt,
+// bidder money, auction state and item-owner changes. No mailbox is published here.
+// Item pointers remain owned by the caller until commit/reconciliation.
+bool MailDraft::QueueAuctionDelivery(uint32 mailId, ObjectGuid receiverGuid,
+    MailSender const& sender, time_t deliverTime)
+{
+    if (!CharacterDatabase.HasActiveTransaction() || !mailId || !receiverGuid.IsPlayer() ||
+        sender.GetMailMessageType() != MAIL_AUCTION || m_mailTemplateId || m_COD ||
+        m_items.size() > 1)
+        return false;
+    const time_t expireDelay = m_items.empty() && !m_money ? HOUR : 30 * DAY;
+    AppendDeliveryToDB(mailId, receiverGuid, sender, MAIL_CHECK_MASK_COPIED,
+        deliverTime, deliverTime + expireDelay, !m_items.empty());
+    return true;
+}
+
+void MailDraft::PublishQueuedAuctionDelivery(uint32 mailId, ObjectGuid receiverGuid,
+    MailSender const& sender, time_t deliverTime)
+{
+    Player* receiver = sObjectMgr.GetPlayer(receiverGuid, false);
+    if (!receiver)
+    {
+        if (!m_items.empty())
+            deleteIncludedItems();
+        return;
+    }
+    if (receiver->GetMail(mailId))
+        return;
+    const time_t expireTime = deliverTime + (m_items.empty() && !m_money ? HOUR : 30 * DAY);
+    Mail* mail = new Mail;
+    mail->messageID = mailId;
+    mail->mailTemplateId = GetMailTemplateId();
+    mail->subject = GetSubject();
+    mail->body = GetBody();
+    mail->money = GetMoney();
+    mail->COD = GetCOD();
+    for (auto const& entry : m_items)
+        mail->AddItem(entry.second->GetGUIDLow(), entry.second->GetEntry());
+    mail->messageType = sender.GetMailMessageType();
+    mail->stationery = sender.GetStationery();
+    mail->sender = sender.GetSenderId();
+    mail->receiverGuid = receiverGuid;
+    mail->expire_time = expireTime;
+    mail->deliver_time = deliverTime;
+    mail->checked = MAIL_CHECK_MASK_COPIED;
+    mail->state = MAIL_STATE_UNCHANGED;
+    receiver->AddNewMailDeliverTime(deliverTime);
+    receiver->AddMail(mail);
+    for (auto const& entry : m_items)
+        receiver->AddMItem(entry.second);
+}
+
+void MailDraft::AppendDeliveryToDB(uint32 mailId, ObjectGuid receiverGuid,
