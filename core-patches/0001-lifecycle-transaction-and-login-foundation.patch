--- /dev/null
+++ b/src/shared/Database/AcknowledgedTransaction.h
@@ -0,0 +1,27 @@
+#ifndef CMANGOS_ACKNOWLEDGED_TRANSACTION_H
+#define CMANGOS_ACKNOWLEDGED_TRANSACTION_H
+
+// Caller owns the connection lock. No database pools or world objects are used.
+// False includes an ambiguous COMMIT: reconcile a durable receipt before retry.
+// Kept independent of core headers for fault-injection tests with a fake connection.
+template<class Connection, class Body>
+bool RunAcknowledgedTransaction(Connection& connection, Body&& body)
+{
+    try
+    {
+        if (!connection.BeginTransaction())
