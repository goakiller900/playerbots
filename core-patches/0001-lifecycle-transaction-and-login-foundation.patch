+bool AuctionHouseMgr::PublishBrokerAuctionFromDB(uint32 auctionId)
+{
+    if (!auctionId)
+        return false;
+    auto auctionResult = CharacterDatabase.PQuery(
+        "SELECT itemguid,houseid,itemowner,buyoutprice,time,moneyTime,buyguid,lastbid,startbid,deposit,"
+        "item_template,item_count,item_randompropertyid FROM auction WHERE id=%u", auctionId);
+    if (!auctionResult)
+        return false;
+    Field* auctionFields = auctionResult->Fetch();
+    const uint32 dbItemGuid = auctionFields[0].GetUInt32();
+    const uint32 owner = auctionFields[2].GetUInt32();
+    AuctionHouseEntry const* house = sAuctionHouseStore.LookupEntry(auctionFields[1].GetUInt32());
+    std::string ownerName;
+    std::wstring wideOwnerName;
+    if (!owner || !house || !sObjectMgr.GetPlayerNameByGUID(ObjectGuid(HIGHGUID_PLAYER, owner), ownerName) ||
+        !Utf8toWStr(ownerName, wideOwnerName))
+        return false;
+    if (AuctionEntry* existing = FindAuction(auctionId))
+    {
+        if (existing->itemGuidLow != dbItemGuid || existing->itemTemplate != auctionFields[10].GetUInt32() ||
+            existing->itemCount != auctionFields[11].GetUInt32() || existing->auctionHouseEntry != house)
+            return false;
+        existing->owner = owner;
+        existing->ownerName = wideOwnerName;
+        existing->buyout = auctionFields[3].GetUInt32(); existing->expireTime = time_t(auctionFields[4].GetUInt64());
+        existing->moneyDeliveryTime = time_t(auctionFields[5].GetUInt64()); existing->bidder = auctionFields[6].GetUInt32();
+        existing->bid = auctionFields[7].GetUInt32(); existing->startbid = auctionFields[8].GetUInt32();
+        existing->deposit = auctionFields[9].GetUInt32();
+        return true;
+    }
+    // Sold auctions have no item to reconstruct and are loaded by the normal
+    // startup path. This helper may only add a new visible listing.
+    if (!dbItemGuid || auctionFields[5].GetUInt64())
+        return false;
+    // Item fields must remain first and in Item::LoadFromDB order.
+    auto result = CharacterDatabase.PQuery(
+        "SELECT i.itemEntry,i.creatorGuid,i.giftCreatorGuid,i.count,i.duration,i.charges,i.flags,i.enchantments,"
+        "i.randomPropertyId,i.durability,i.playedTime,i.text,a.itemguid,a.houseid,a.itemowner,a.buyoutprice,"
+        "a.time,a.moneyTime,a.buyguid,a.lastbid,a.startbid,a.deposit,a.item_template,a.item_count,"
+        "a.item_randompropertyid FROM auction a INNER JOIN item_instance i ON i.guid=a.itemguid WHERE a.id=%u", auctionId);
+    if (!result)
+        return false;
+    Field* f = result->Fetch();
+    const uint32 itemGuid = f[12].GetUInt32();
+    ItemPrototype const* proto = ObjectMgr::GetItemPrototype(f[0].GetUInt32());
+    if (itemGuid != dbItemGuid || owner != f[14].GetUInt32() || house != sAuctionHouseStore.LookupEntry(f[13].GetUInt32()))
+        return false;
+    if (!itemGuid || !house || !proto || GetAItem(itemGuid))
+        return false;
+    Item* item = NewItemOrBag(proto);
+    if (!item || !item->LoadFromDB(itemGuid, f, ObjectGuid(HIGHGUID_PLAYER, owner)))
+    {
+        delete item;
+        return false;
+    }
+    if (item->GetEntry() != f[22].GetUInt32() || item->GetCount() != f[23].GetUInt32() ||
+        item->GetItemRandomPropertyId() != f[24].GetInt32())
+    {
+        delete item;
+        return false;
+    }
+    AuctionEntry* auction = new AuctionEntry;
+    auction->Id = auctionId;
+    auction->itemGuidLow = itemGuid;
+    auction->itemTemplate = item->GetEntry();
+    auction->itemCount = item->GetCount();
+    auction->itemRandomPropertyId = item->GetItemRandomPropertyId();
+    auction->owner = owner;
+    auction->ownerName = wideOwnerName;
+    auction->buyout = f[15].GetUInt32();
+    auction->expireTime = time_t(f[16].GetUInt64());
+    auction->moneyDeliveryTime = time_t(f[17].GetUInt64());
+    auction->bidder = f[18].GetUInt32();
+    auction->bid = f[19].GetUInt32();
+    auction->startbid = f[20].GetUInt32();
+    auction->deposit = f[21].GetUInt32();
+    auction->auctionHouseEntry = house;
+    AddAItem(item);
+    GetAuctionsMap(house)->AddAuction(auction);
+    return true;
+}
